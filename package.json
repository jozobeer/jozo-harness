{
  "name": "@jozo-harness/root",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc && tsc -p apps/web/client-solid",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "coverage:gate": "node scripts/coverage-gate.ts",
    "bundle:check": "node scripts/browser-bundle-check.ts",
    "doc:gate": "node scripts/doc-gate.ts",
    "duplication": "node scripts/duplication-gate.ts",
    "ab": "node scripts/ab/run.ts",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "complexity": "cccc --top-cognitive 10 --table --exclude '**/dist/**' apps packages",
    "check:static": "vp check && vp run lint && vp run typecheck && vp run doc:gate && vp run duplication && vp run complexity && vp run rust:check && vp run bundle:check",
    "check": "vp run check:static && vp -C apps/web/client-solid test && vp run coverage:gate",
    "prepare": "git config core.hooksPath .githooks",
    "build:web": "vp -C apps/web/client-solid build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "jscpd": "5.4.1",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
